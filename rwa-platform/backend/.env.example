# 服务端口
PORT=4000

# 数据库配置
DATABASE_URL="postgresql://postgres:password@localhost:5432/rwa_platform?schema=public"

# JWT配置
JWT_SECRET="your-super-secret-jwt-key-change-in-production-min-32-chars"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-in-production"
JWT_REFRESH_EXPIRES_IN="30d"

# 文件上传
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=5242880
ALLOWED_IMAGE_TYPES="image/jpeg,image/png,image/jpg"

# CORS配置
CORS_ORIGIN="http://localhost:3000"

# 邮件配置（可选）
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
EMAIL_FROM="noreply@rwa-platform.com"

# 区块链配置（模拟）
BLOCKCHAIN_ENABLED=false
ETHEREUM_RPC_URL="https://mainnet.infura.io/v3/YOUR-PROJECT-ID"
POLYGON_RPC_URL="https://polygon-rpc.com"

# 系统配置
NODE_ENV="development"
LOG_LEVEL="debug"

# 交易配置
DEFAULT_FEE_RATE=0.001
VIP_FEE_RATE=0.0005
MIN_WITHDRAW_AMOUNT=10
MAX_WITHDRAW_AMOUNT=100000

# KYC配置
KYC_REVIEW_SLA_HOURS=24

# 推荐奖励配置
REFERRAL_REWARD_AMOUNT=10
REFERRAL_COMMISSION_RATE=0.1
